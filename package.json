{
  "name": "replaydeck",
  "version": "0.0.0-development",
  "description": "Session replay recorder that ships rrweb events to a ReplayDeck collector.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReplayDeck/js.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "rrweb": "2.1.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "semantic-release": "^24.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
